---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MarketTicker from "../components/MarketTicker.astro";
import MarketTools from "../components/MarketTools.astro";
import RoadHighlights from "../components/RoadHighlights.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "../styles/v16.css";
import "../styles/v17.css";
import "../styles/v18.css";
import "../styles/v19.css";
import "../styles/v21.css";
import "../styles/v23.css";
import "../styles/v24.css";
import "../styles/v25.css";
import "../styles/v30.css";
import "../styles/v31.css";
import "../styles/v32.css";
import "../styles/v35.css";
import "../styles/v36.css";
import "../styles/v37.css";
import "../styles/v38.css";
import "../styles/v40.css";
import "../styles/v44.css";
const BUILD_VERSION = "43.0.0";
const { title = "ROAD Wealth®", description = "ROAD Wealth — consultoria de investimentos e cuidado patrimonial com visão integrada.", active = "", noindex = true } = Astro.props;
---
<!doctype html>
<html lang="pt-BR" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#F3ECE3" />
    <meta name="road-build" content={BUILD_VERSION} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/assets/favicon.ico" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="preconnect" href="https://s3.tradingview.com" crossorigin />
    
    <link rel="dns-prefetch" href="https://s3.tradingview.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@400;500;600&family=Questrial&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body data-road-build={BUILD_VERSION}>
    <div class="site-top-stack" id="site-top-stack" transition:persist="road-site-top">
      <Header active={active} />
      <MarketTicker />
      <RoadHighlights />
      <div class="market-ticker-note road-market-note" aria-label="Fontes e atraso das cotações">
        B3 · 15 min de atraso &nbsp;|&nbsp; via TradingView
      </div>
    </div>
    <main>
      <slot />
    </main>
    <Footer />
    <MarketTools />
    <script is:inline>
      (()=>{
        if(window.__roadPersistentShellBound) return;
        window.__roadPersistentShellBound=true;

        const root=document.documentElement;
        let stackObserver=null;
        let observedStack=null;
        let mainObserver=null;
        let tickerToneFrame=0;

        const getStack=()=>document.getElementById('site-top-stack');

        const syncStickyTop=()=>{
          const stack=getStack();
          if(!stack) return;
          root.style.setProperty('--sticky-top',`${Math.ceil(stack.getBoundingClientRect().height)}px`);
        };

        const ensureStackObserver=()=>{
          const stack=getStack();
          if(!stack || !('ResizeObserver' in window) || stack===observedStack) return;
          stackObserver?.disconnect();
          stackObserver=new ResizeObserver(syncStickyTop);
          stackObserver.observe(stack);
          observedStack=stack;
        };

        const syncNavigationState=()=>{
          const path=location.pathname.replace(/\/+$/,'') || '/';
          const inSection=section=>path===`/${section}` || path.startsWith(`/${section}/`);
          let active='';
          if(inSection('a-road')) active='a-road';
          else if(inSection('investimentos')) active='investimentos';
          else if(inSection('patrimonio')) active='patrimonio';
          else if(inSection('conhecimento') || inSection('glossario') || inSection('calculadora-ir')) active='conhecimento';
          else if(inSection('contato')) active='contato';

          document.querySelectorAll('[data-road-nav]').forEach(link=>{
            link.classList.toggle('is-active',link.getAttribute('data-road-nav')===active);
          });

          const nav=document.getElementById('nav');
          const toggle=document.getElementById('nav-toggle');
          nav?.classList.remove('open');
          toggle?.setAttribute('aria-expanded','false');
        };

        const syncTickerNoteTone=()=>{
          const stack=getStack();
          const tickerNote=document.querySelector('.market-ticker-note');
          const main=document.querySelector('main');
          if(!tickerNote || !main) return;
          const y=Math.ceil(stack?.getBoundingClientRect().height || 0)+8;
          const x=Math.max(12,window.innerWidth-40);
          const layer=document.elementsFromPoint(x,y);
          const surface=layer.map(el=>el.closest?.('.section,.road-callout')).find(Boolean)
            || [...main.querySelectorAll('.section,.road-callout')].find(el=>!el.hidden && getComputedStyle(el).display!=='none');
          const dark=surface?.matches('.section--coffee,.section--petrol,.section--olive,.road-callout--petrol,.hero--road-photo') ?? false;
          tickerNote.classList.toggle('is-on-dark',dark);
        };

        const requestTickerNoteTone=()=>{
          if(tickerToneFrame) return;
          tickerToneFrame=requestAnimationFrame(()=>{
            tickerToneFrame=0;
            syncTickerNoteTone();
          });
        };

        const observeCurrentMain=()=>{
          mainObserver?.disconnect();
          const main=document.querySelector('main');
          if(main && 'MutationObserver' in window){
            mainObserver=new MutationObserver(requestTickerNoteTone);
            mainObserver.observe(main,{subtree:true,attributes:true,attributeFilter:['hidden','class']});
          }
        };

        const refreshShell=()=>{
          ensureStackObserver();
          syncStickyTop();
          syncNavigationState();
          observeCurrentMain();
          requestTickerNoteTone();
        };

        window.addEventListener('resize',()=>{
          syncStickyTop();
          requestTickerNoteTone();
        },{passive:true});
        window.addEventListener('scroll',requestTickerNoteTone,{passive:true});
        document.addEventListener('astro:after-swap',refreshShell);
        document.addEventListener('astro:page-load',refreshShell);

        refreshShell();
      })();
    </script>
  </body>
</html>
