<section class="road-highlights" aria-label="Destaques" data-road-highlights>
  <div class="road-highlights__inner">
    <div class="road-highlights__label">DESTAQUE</div>

    <div class="road-highlights__stage">
      <div class="road-highlights__pager" aria-label="Escolher destaque">
        <div class="road-highlights__dots">
          <button class="is-active" data-highlight-dot type="button" aria-label="Mostrar Check-up ROAD"></button>
          <button data-highlight-dot type="button" aria-label="Mostrar Calculadora de IR 2026"></button>
          <button data-highlight-dot type="button" aria-label="Mostrar Mercados & Ferramentas"></button>
        </div>
      </div>

      <a class="road-highlights__slide is-active" data-highlight-slide data-highlight-kind="checkup" aria-hidden="false" href="/patrimonio/#checkup-road">
        <span class="road-highlights__slide-copy">Como está seu planejamento financeiro? Faça um teste rápido e receba seu diagnóstico.</span>
        <span class="road-highlights__arrow" aria-hidden="true">→</span>
      </a>

      <a class="road-highlights__slide" data-highlight-slide data-highlight-kind="ir" aria-hidden="true" href="/calculadora-ir/">
        <span class="road-highlights__slide-copy">Planeje melhor seu IR. Simule PGBL, deduções e incentivos fiscais.</span>
        <span class="road-highlights__arrow" aria-hidden="true">→</span>
      </a>

      <button class="road-highlights__slide js-open-market-tools" data-highlight-slide data-highlight-kind="markets" aria-hidden="true" type="button">
        <span class="road-highlights__slide-copy">Acompanhe mercados, juros, câmbio e ferramentas para suas decisões.</span>
        <span class="road-highlights__arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (()=>{
    const roots=document.querySelectorAll('[data-road-highlights]');
    roots.forEach(root=>{
      if(!(root instanceof HTMLElement) || root.dataset.highlightsReady==='1') return;
      root.dataset.highlightsReady='1';

      const slides=[...root.querySelectorAll('[data-highlight-slide]')];
      const dots=[...root.querySelectorAll('[data-highlight-dot]')];
      const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
      let index=0;
      let timer=0;
      let paused=false;

      const render=(target)=>{
        if(!slides.length) return;
        index=(target+slides.length)%slides.length;
        slides.forEach((slide,i)=>{
          const active=i===index;
          slide.classList.toggle('is-active',active);
          slide.setAttribute('aria-hidden',active ? 'false' : 'true');
          if(slide instanceof HTMLElement) slide.tabIndex=active ? 0 : -1;
        });
        dots.forEach((dot,i)=>{
          dot.classList.toggle('is-active',i===index);
          dot.setAttribute('aria-current',i===index ? 'true' : 'false');
        });
      };

      const stop=()=>{
        if(timer) window.clearInterval(timer);
        timer=0;
      };

      const start=()=>{
        stop();
        if(paused || reduced.matches || slides.length<2) return;
        timer=window.setInterval(()=>render(index+1),7000);
      };

      dots.forEach((dot,i)=>dot.addEventListener('click',event=>{
        event.preventDefault();
        event.stopPropagation();
        render(i);
        start();
      }));

      root.addEventListener('mouseenter',()=>{paused=true;stop()});
      root.addEventListener('mouseleave',()=>{paused=false;start()});
      root.addEventListener('focusin',()=>{paused=true;stop()});
      root.addEventListener('focusout',event=>{
        if(event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return;
        paused=false;
        start();
      });

      const onReducedChange=()=>start();
      if(typeof reduced.addEventListener==='function') reduced.addEventListener('change',onReducedChange);
      else if(typeof reduced.addListener==='function') reduced.addListener(onReducedChange);

      render(0);
      start();
    });
  })();
</script>
