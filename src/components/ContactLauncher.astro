<div class="contact-launcher" data-contact-launcher>
  <button class="contact-launcher-toggle" type="button" aria-expanded="false" aria-controls="contact-launcher-panel" aria-label="Fale com a ROAD">
    <svg class="contact-launcher-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4.2 5.8A3.3 3.3 0 0 1 7.5 2.5h9A3.3 3.3 0 0 1 19.8 5.8v6.7a3.3 3.3 0 0 1-3.3 3.3H10l-4.6 3.7.9-3.9a3.3 3.3 0 0 1-2.1-3.1V5.8Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <circle cx="8.5" cy="9.2" r="1" fill="currentColor"/>
      <circle cx="12" cy="9.2" r="1" fill="currentColor"/>
      <circle cx="15.5" cy="9.2" r="1" fill="currentColor"/>
    </svg>
    <span class="contact-launcher-label">Fale com a ROAD</span>
  </button>

  <section class="contact-launcher-panel" id="contact-launcher-panel" aria-label="Conversa com a ROAD" hidden>
    <div class="contact-launcher-top">
      <div><strong class="contact-launcher-brand">ROAD Wealth</strong><div class="contact-launcher-heading">Atendimento pelo WhatsApp</div></div>
      <button type="button" class="contact-launcher-close" aria-label="Fechar conversa">×</button>
    </div>
    <p class="contact-launcher-welcome">Olá! Como podemos ajudar?</p>
    <label class="contact-launcher-field-label" for="contact-launcher-message">Sua mensagem</label>
    <textarea class="contact-launcher-message" id="contact-launcher-message" rows="3" maxlength="1200">Olá! Conheci a ROAD Wealth pelo site e gostaria de conversar com a equipe.</textarea>
    <a class="contact-launcher-action contact-launcher-send" href="https://wa.me/5542984242852?text=Ol%C3%A1!%20Conheci%20a%20ROAD%20Wealth%20pelo%20site%20e%20gostaria%20de%20conversar%20com%20a%20equipe." target="_blank" rel="noopener noreferrer">Enviar pelo WhatsApp →</a>
    <p class="contact-launcher-note">A conversa continuará no WhatsApp. Nenhuma mensagem é enviada automaticamente.</p>
    <div class="contact-launcher-alternatives">
      <a class="contact-launcher-action" href="mailto:contato@roadwealth.com.br">E-mail</a>
      <a class="contact-launcher-action" href="/contato/">Outros canais de contato</a>
    </div>
  </section>
</div>

<script is:inline>
  (()=>{
    const getLauncher=()=>document.querySelector('[data-contact-launcher]');
    const closeLauncher=()=>{
      const launcher=getLauncher();
      const toggle=launcher?.querySelector('.contact-launcher-toggle');
      const panel=launcher?.querySelector('.contact-launcher-panel');
      if(panel instanceof HTMLElement) panel.hidden=true;
      toggle?.setAttribute('aria-expanded','false');
      launcher?.classList.remove('is-open');
    };

    const positionLauncher=()=>{
      const launcher=getLauncher();
      const footer=document.querySelector('.footer');
      if(!launcher) return;
      const rect=footer instanceof HTMLElement?footer.getBoundingClientRect():null;
      const overlap=rect && rect.top<window.innerHeight && rect.bottom>0?Math.max(0,window.innerHeight-rect.top):0;
      launcher.style.setProperty('--road-footer-overlap',Math.round(Math.min(overlap,Math.max(0,window.innerHeight-120)))+'px');
    };
    let positionQueued=false;
    const schedulePosition=()=>{
      if(positionQueued)return;
      positionQueued=true;
      requestAnimationFrame(()=>{positionQueued=false;positionLauncher()});
    };

    if(!window.__roadContactLauncherBound){
      window.__roadContactLauncherBound=true;

      document.addEventListener('click',event=>{
        const target=event.target instanceof Element ? event.target : null;
        if(!target) return;
        const launcher=getLauncher();
        if(!launcher) return;

        const toggle=target.closest('.contact-launcher-toggle');
        if(toggle){
          event.preventDefault();
          const panel=launcher.querySelector('.contact-launcher-panel');
          const willOpen=panel instanceof HTMLElement && panel.hidden;
          if(panel instanceof HTMLElement) panel.hidden=!willOpen;
          toggle.setAttribute('aria-expanded',willOpen?'true':'false');
          launcher.classList.toggle('is-open',willOpen);
          if(willOpen) launcher.querySelector('.contact-launcher-message')?.focus();
          return;
        }

        if(target.closest('.contact-launcher-close')){
          event.preventDefault();
          closeLauncher();
          launcher.querySelector('.contact-launcher-toggle')?.focus();
          return;
        }
        if(target.closest('.contact-launcher-send[aria-disabled="true"]')){
          event.preventDefault();
          return;
        }
        if(target.closest('.contact-launcher-action')){
          closeLauncher();
          return;
        }

        if(!target.closest('[data-contact-launcher]')) closeLauncher();
      });

      document.addEventListener('input',event=>{
        const target=event.target;
        if(!(target instanceof HTMLTextAreaElement)||!target.matches('.contact-launcher-message'))return;
        const link=target.closest('[data-contact-launcher]')?.querySelector('.contact-launcher-send');
        if(!(link instanceof HTMLAnchorElement))return;
        const message=target.value.trim();
        link.href=message?'https://wa.me/5542984242852?text='+encodeURIComponent(message):'#';
        link.setAttribute('aria-disabled',message?'false':'true');
      });
      document.addEventListener('keydown',event=>{
        if(event.key==='Escape') closeLauncher();
      });

      document.addEventListener('astro:after-swap',()=>{
        closeLauncher();
        schedulePosition();
      });
      document.addEventListener('astro:page-load',schedulePosition);
      window.addEventListener('scroll',schedulePosition,{passive:true});
      window.addEventListener('resize',schedulePosition,{passive:true});
    }

    schedulePosition();
  })();
</script>
