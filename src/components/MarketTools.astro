<div class="modal" hidden id="modal">
  <div aria-labelledby="modal-title" aria-modal="true" class="modal-card" role="dialog">
    <div class="eyebrow">EM DESENVOLVIMENTO</div>
    <h3 id="modal-title">Recurso em preparação</h3>
    <p id="modal-message"></p>
    <div class="modal-actions"><button class="btn btn--primary" id="modal-close" type="button">Fechar</button></div>
  </div>
</div>

<script is:inline>
  (()=>{
    if(window.__roadMarketToolsBound) return;
    window.__roadMarketToolsBound=true;

    const openUtility=()=>{
      const panel=document.getElementById('utility-panel');
      const overlay=document.getElementById('utility-overlay');
      panel?.classList.add('open');
      overlay?.classList.add('open');
      panel?.setAttribute('aria-hidden','false');
    };

    const closeUtility=()=>{
      const panel=document.getElementById('utility-panel');
      const overlay=document.getElementById('utility-overlay');
      panel?.classList.remove('open');
      overlay?.classList.remove('open');
      panel?.setAttribute('aria-hidden','true');
    };

    const showModal=message=>{
      const modal=document.getElementById('modal');
      const modalMsg=document.getElementById('modal-message');
      if(modalMsg) modalMsg.textContent=message;
      if(modal) modal.hidden=false;
    };

    const closeModal=()=>{
      const modal=document.getElementById('modal');
      if(modal) modal.hidden=true;
    };

    document.addEventListener('click',event=>{
      const target=event.target instanceof Element ? event.target : null;
      if(!target) return;

      if(target.closest('#utility-tab,#mobile-utility,.js-open-market-tools')){
        event.preventDefault();
        openUtility();
        return;
      }

      if(target.closest('#utility-close') || target.matches('#utility-overlay')){
        closeUtility();
        return;
      }

      const placeholder=target.closest('.js-placeholder');
      if(placeholder){
        event.preventDefault();
        showModal(placeholder.getAttribute('data-message') || 'Recurso em preparação.');
        return;
      }

      if(target.closest('#modal-close')){
        closeModal();
        return;
      }

      const modal=document.getElementById('modal');
      if(target===modal) closeModal();
    });

    document.addEventListener('keydown',event=>{
      if(event.key!=='Escape') return;
      closeUtility();
      closeModal();
    });
  })();
</script>


<script is:inline>
  (()=> {
    const refreshFooterWatch=()=>{
      const button=document.getElementById('mobile-utility');
      const footer=document.querySelector('.footer');
      window.__roadMobileFooterObserver?.disconnect?.();
      if(!button || !footer || !('IntersectionObserver' in window)) return;
      const observer=new IntersectionObserver(entries=>{
        button.classList.toggle('is-footer-visible',entries.some(entry=>entry.isIntersecting));
      },{threshold:0});
      observer.observe(footer);
      window.__roadMobileFooterObserver=observer;
    };

    window.__roadRefreshMobileUtilityFooter=refreshFooterWatch;
    if(!window.__roadMobileFooterWatchBound){
      window.__roadMobileFooterWatchBound=true;
      document.addEventListener('astro:after-swap',()=>window.__roadRefreshMobileUtilityFooter?.());
      document.addEventListener('astro:page-load',()=>window.__roadRefreshMobileUtilityFooter?.());
    }
    refreshFooterWatch();
  })();
</script>
