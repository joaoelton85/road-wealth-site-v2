---
const tickerSymbols = [
  { proName: "BMFBOVESPA:IBOV", title: "IBOV" },
  { proName: "BMFBOVESPA:IFIX", title: "IFIX" },
  { proName: "BMFBOVESPA:SMLL", title: "SMLL" },
  { proName: "BMFBOVESPA:IVVB11", title: "IVVB11 (BRL)" },
  { proName: "FX_IDC:USDBRL", title: "USD/BRL" },
  { proName: "FX_IDC:EURBRL", title: "EUR/BRL" },
  { proName: "CMCMARKETS:GOLD", title: "Ouro (USD)" },
  { proName: "BMFBOVESPA:DI1F2030", title: "DI Jan/30" },
  { proName: "BMFBOVESPA:DI1F2035", title: "DI Jan/35" },
  { proName: "BITSTAMP:BTCUSD", title: "Bitcoin (USD)" },
];

const mobileSymbols = tickerSymbols.map(({ proName }) => proName).join(",");
---
<div
  class="market-ticker-shell"
  id="market-ticker-shell"
  aria-label="Cotações de mercado"
  data-ticker-symbols={JSON.stringify(tickerSymbols)}
>
  <div class="market-ticker-row market-ticker-row--desktop">
    <div class="market-ticker-label" aria-hidden="true">MERCADOS</div>

    <div class="market-ticker-track">
      <div class="ticker-placeholder" aria-hidden="true"></div>
      <div class="market-ticker-viewport" aria-hidden="true">
        <div class="market-ticker-scale-frame">
          <div class="tradingview-widget-container">
            <div class="tradingview-widget-container__widget"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="market-ticker-mobile-live" aria-label="Indicadores de mercado">
    <div class="market-ticker-mobile-label" aria-hidden="true">MERCADOS</div>
    <div class="market-ticker-mobile-widget">
      <tv-ticker-tape
        symbols={mobileSymbols}
        direction="horizontal"
        item-size="compact"
        theme="dark"
        transparent
      >
        <div class="market-ticker-mobile-placeholder">IBOV · IFIX · SMLL · IVVB11 · USD/BRL · EUR/BRL · Ouro · DI30 · DI35 · Bitcoin</div>
      </tv-ticker-tape>
    </div>
  </div>

  <div class="market-ticker-note" aria-label="Fontes e atraso das cotações">
    <span class="market-ticker-note-full">Dados e atrasos conforme o mercado e a fonte &nbsp;|&nbsp; B3 · 15 min de atraso &nbsp;|&nbsp; via TradingView</span>
    <span class="market-ticker-note-compact">B3 · 15 min de atraso &nbsp;|&nbsp; via TradingView</span>
  </div>
</div>

<script is:inline>
  (()=>{
    const root=document.getElementById('market-ticker-shell');
    if(!root || root.dataset.tickerInit==='1') return;
    root.dataset.tickerInit='1';

    if(window.matchMedia('(max-width: 680px)').matches){
      import('https://www.tradingview-widget.com/w/en/tv-ticker-tape.js').catch(()=>{
        root.classList.add('is-mobile-ticker-fallback');
      });
      return;
    }

    const container=root.querySelector('.tradingview-widget-container');
    if(!container) return;

    let symbols=[];
    try{
      symbols=JSON.parse(root.dataset.tickerSymbols || '[]');
    }catch{
      symbols=[];
    }

    const config={
      symbols,
      colorTheme:'dark',
      locale:'br',
      largeChartUrl:'',
      isTransparent:true,
      showSymbolLogo:true,
      displayMode:'adaptive',
    };

    let ready=false;
    let settleTimer=0;
    let pollTimer=0;
    const observer=new MutationObserver(scan);

    const reveal=()=>{
      if(ready) return;
      ready=true;
      window.clearTimeout(settleTimer);
      window.clearInterval(pollTimer);
      observer.disconnect();
      requestAnimationFrame(()=>requestAnimationFrame(()=>root.classList.add('is-ticker-ready')));
    };

    const arm=(iframe)=>{
      if(!(iframe instanceof HTMLIFrameElement) || iframe.dataset.roadTickerArmed==='1') return;
      iframe.dataset.roadTickerArmed='1';
      const settle=()=>{
        window.clearTimeout(settleTimer);
        settleTimer=window.setTimeout(reveal,650);
      };
      iframe.addEventListener('load',settle,{once:true});
      window.setTimeout(()=>{
        if(!ready && iframe.isConnected) settle();
      },4200);
    };

    function scan(){
      container.querySelectorAll('iframe').forEach(arm);
    }

    observer.observe(container,{childList:true,subtree:true});
    pollTimer=window.setInterval(scan,250);
    window.setTimeout(()=>window.clearInterval(pollTimer),10000);

    const embed=document.createElement('script');
    embed.type='text/javascript';
    embed.src='https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js';
    embed.async=true;
    embed.textContent=JSON.stringify(config);
    container.appendChild(embed);
    scan();
  })();
</script>
