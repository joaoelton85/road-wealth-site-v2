---
const tickerSymbols = [
  { proName: "BMFBOVESPA:IBOV", title: "IBOV" },
  { proName: "BMFBOVESPA:IFIX", title: "IFIX" },
  { proName: "BMFBOVESPA:SMLL", title: "SMLL" },
  { proName: "BMFBOVESPA:IVVB11", title: "IVVB11 (BRL)" },
  { proName: "FX_IDC:USDBRL", title: "USD/BRL" },
  { proName: "FX_IDC:EURBRL", title: "EUR/BRL" },
  { proName: "CMCMARKETS:GOLD", title: "Ouro (USD)" },
  { proName: "BMFBOVESPA:DI1F2030", title: "DI Jan/30" },
  { proName: "BMFBOVESPA:DI1F2035", title: "DI Jan/35" },
  { proName: "BITSTAMP:BTCUSD", title: "Bitcoin (USD)" },
];
---
<div
  class="market-ticker-shell"
  id="market-ticker-shell"
  aria-label="Cotações de mercado"
  data-ticker-symbols={JSON.stringify(tickerSymbols)}
>
  <div class="market-ticker-row market-ticker-row--desktop">
    <div class="market-ticker-label" aria-hidden="true">MERCADOS</div>
    <div class="market-ticker-track">
      <div class="ticker-placeholder market-ticker-placeholder--desktop">Carregando cotações…</div>
      <div class="market-ticker-viewport" aria-hidden="true">
        <div class="market-ticker-scale-frame">
          <div class="tradingview-widget-container" data-road-ticker="desktop">
            <div class="tradingview-widget-container__widget"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="market-ticker-mobile-live" aria-label="Indicadores de mercado">
    <div class="market-ticker-mobile-label" aria-hidden="true">MERCADOS</div>
    <div class="market-ticker-mobile-window">
      <div class="ticker-placeholder market-ticker-mobile-placeholder">Carregando cotações…</div>
      <div class="market-ticker-mobile-viewport" aria-hidden="true">
        <div class="tradingview-widget-container market-ticker-mobile-widget" data-road-ticker="mobile">
          <div class="tradingview-widget-container__widget"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="market-ticker-note" aria-label="Fontes e atraso das cotações">
    <span class="market-ticker-note-full">Dados e atrasos conforme o mercado e a fonte &nbsp;|&nbsp; B3 · 15 min de atraso &nbsp;|&nbsp; via TradingView</span>
    <span class="market-ticker-note-compact">B3 · 15 min de atraso &nbsp;|&nbsp; via TradingView</span>
  </div>
</div>

<script is:inline>
  (()=>{
    const root=document.getElementById('market-ticker-shell');
    if(!root || root.dataset.tickerController==='1') return;
    root.dataset.tickerController='1';

    let symbols=[];
    try{
      symbols=JSON.parse(root.dataset.tickerSymbols || '[]');
    }catch{
      symbols=[];
    }

    const media=window.matchMedia('(max-width: 680px)');
    const states={
      desktop:{
        host:root.querySelector('[data-road-ticker="desktop"]'),
        placeholder:root.querySelector('.market-ticker-placeholder--desktop'),
        started:false,
        ready:false,
        timer:0,
        observer:null,
      },
      mobile:{
        host:root.querySelector('[data-road-ticker="mobile"]'),
        placeholder:root.querySelector('.market-ticker-mobile-placeholder'),
        started:false,
        ready:false,
        timer:0,
        observer:null,
      },
    };

    const setReady=(mode)=>{
      const state=states[mode];
      if(!state || state.ready) return;
      state.ready=true;
      window.clearTimeout(state.timer);
      state.observer?.disconnect();
      root.classList.remove(`is-${mode}-ticker-error`);
      requestAnimationFrame(()=>requestAnimationFrame(()=>{
        root.classList.add(`is-${mode}-ticker-ready`);
      }));
    };

    const setError=(mode)=>{
      const state=states[mode];
      if(!state || state.ready) return;
      state.observer?.disconnect();
      root.classList.add(`is-${mode}-ticker-error`);
      if(state.placeholder){
        state.placeholder.textContent='Cotações temporariamente indisponíveis';
      }
    };

    const init=(mode)=>{
      const state=states[mode];
      if(!state?.host || state.started) return;
      state.started=true;

      const scan=()=>{
        const iframe=state.host.querySelector('iframe');
        if(!(iframe instanceof HTMLIFrameElement) || iframe.dataset.roadTickerArmed==='1') return;
        iframe.dataset.roadTickerArmed='1';

        const reveal=()=>window.setTimeout(()=>setReady(mode),250);
        iframe.addEventListener('load',reveal,{once:true});

        window.setTimeout(()=>{
          if(!state.ready && iframe.isConnected) setReady(mode);
        },2200);
      };

      state.observer=new MutationObserver(scan);
      state.observer.observe(state.host,{childList:true,subtree:true});

      const config={
        symbols,
        colorTheme:'dark',
        locale:'br',
        largeChartUrl:'',
        isTransparent:mode==='mobile' ? false : true,
        showSymbolLogo:true,
        displayMode:mode==='mobile' ? 'regular' : 'adaptive',
      };

      const embed=document.createElement('script');
      embed.type='text/javascript';
      embed.src='https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js';
      embed.async=true;
      embed.textContent=JSON.stringify(config);
      embed.addEventListener('error',()=>setError(mode),{once:true});
      state.host.appendChild(embed);

      scan();
      state.timer=window.setTimeout(()=>setError(mode),9000);
    };

    const sync=()=>init(media.matches ? 'mobile' : 'desktop');

    sync();
    if(typeof media.addEventListener==='function'){
      media.addEventListener('change',sync);
    }else if(typeof media.addListener==='function'){
      media.addListener(sync);
    }
  })();
</script>
