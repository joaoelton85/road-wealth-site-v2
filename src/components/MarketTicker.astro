---
const tickerSymbols = [
  { proName: "BMFBOVESPA:IBOV", title: "IBOV" },
  { proName: "BMFBOVESPA:IFIX", title: "IFIX" },
  { proName: "BMFBOVESPA:SMLL", title: "SMLL" },
  { proName: "BMFBOVESPA:IVVB11", title: "IVVB11 (BRL)" },
  { proName: "FX_IDC:USDBRL", title: "USD/BRL" },
  { proName: "FX_IDC:EURBRL", title: "EUR/BRL" },
  { proName: "CMCMARKETS:GOLD", title: "Ouro (USD)" },
  { proName: "BMFBOVESPA:DI1F2030", title: "DI Jan/30" },
  { proName: "BMFBOVESPA:DI1F2035", title: "DI Jan/35" },
  { proName: "BITSTAMP:BTCUSD", title: "Bitcoin (USD)" },
];

const mobileSymbols = tickerSymbols.map(({ proName }) => proName).join(",");
---
<div
  class="market-ticker-shell"
  id="market-ticker-shell"
  aria-label="Cotações de mercado"
  data-ticker-symbols={JSON.stringify(tickerSymbols)}
>
  <div class="market-ticker-row market-ticker-row--desktop">
    <div class="market-ticker-label" aria-hidden="true">MERCADOS</div>
    <div class="market-ticker-track">
      <div class="ticker-placeholder market-ticker-placeholder--desktop">Carregando cotações…</div>
      <div class="market-ticker-viewport" aria-hidden="true">
        <div class="market-ticker-scale-frame">
          <div class="tradingview-widget-container" data-road-ticker="desktop">
            <div class="tradingview-widget-container__widget"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="market-ticker-mobile-live" aria-label="Indicadores de mercado">
    <div class="market-ticker-mobile-label" aria-hidden="true">MERCADOS</div>
    <div class="market-ticker-mobile-window">
      <tv-ticker-tape
        class="market-ticker-mobile-widget"
        symbols={mobileSymbols}
        direction="horizontal"
        item-size="compact"
        theme="dark"
        transparent
        hide-chart
      >
        <div class="market-ticker-mobile-placeholder">Carregando cotações…</div>
      </tv-ticker-tape>
    </div>
  </div>
</div>

<script is:inline type="module">
  (async()=>{
    const sources=[
      'https://widgets.tradingview-widget.com/w/en/tv-ticker-tape.js',
      'https://www.tradingview-widget.com/w/en/tv-ticker-tape.js',
    ];

    for(const source of sources){
      try{
        await import(source);
        await customElements.whenDefined('tv-ticker-tape');
        document.documentElement.dataset.roadTvMobile='ready';
        return;
      }catch{
        // Tenta a origem alternativa do próprio TradingView.
      }
    }

    document.documentElement.dataset.roadTvMobile='pending';
  })();
</script>

<script is:inline>
  (()=>{
    const root=document.getElementById('market-ticker-shell');
    if(!root || root.dataset.desktopTickerInit==='1') return;
    root.dataset.desktopTickerInit='1';

    const container=root.querySelector('[data-road-ticker="desktop"]');
    if(!(container instanceof HTMLElement)) return;

    let symbols=[];
    try{
      symbols=JSON.parse(root.dataset.tickerSymbols || '[]');
    }catch{
      symbols=[];
    }

    let ready=false;
    const setReady=()=>{
      if(ready) return;
      ready=true;
      requestAnimationFrame(()=>requestAnimationFrame(()=>{
        root.classList.add('is-desktop-ticker-ready');
      }));
    };

    const observer=new MutationObserver(()=>{
      const iframe=container.querySelector('iframe');
      if(!(iframe instanceof HTMLIFrameElement) || iframe.dataset.roadTickerArmed==='1') return;
      iframe.dataset.roadTickerArmed='1';
      iframe.addEventListener('load',()=>window.setTimeout(setReady,250),{once:true});
      window.setTimeout(()=>{
        if(!ready && iframe.isConnected) setReady();
      },2200);
    });
    observer.observe(container,{childList:true,subtree:true});

    const config={
      symbols,
      colorTheme:'dark',
      locale:'br',
      largeChartUrl:'',
      isTransparent:true,
      showSymbolLogo:true,
      displayMode:'adaptive',
    };

    const embed=document.createElement('script');
    embed.type='text/javascript';
    embed.src='https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js';
    embed.async=true;
    embed.textContent=JSON.stringify(config);
    container.appendChild(embed);
  })();
</script>
