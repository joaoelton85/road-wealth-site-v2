---
const tickerSymbols = [
  { proName: "BMFBOVESPA:IBOV", title: "IBOV" },
  { proName: "BMFBOVESPA:IFIX", title: "IFIX" },
  { proName: "BMFBOVESPA:SMLL", title: "SMLL" },
  { proName: "BMFBOVESPA:IVVB11", title: "IVVB11 (BRL)" },
  { proName: "FX_IDC:USDBRL", title: "USD/BRL" },
  { proName: "FX_IDC:EURBRL", title: "EUR/BRL" },
  { proName: "CMCMARKETS:GOLD", title: "Ouro (USD)" },
  { proName: "BMFBOVESPA:DI1F2030", title: "DI Jan/30" },
  { proName: "BMFBOVESPA:DI1F2035", title: "DI Jan/35" },
  { proName: "BITSTAMP:BTCUSD", title: "Bitcoin (USD)" },
];
---
<div
  class="market-ticker-shell market-ticker-shell--unified"
  id="market-ticker-shell"
  aria-label="Cotações de mercado"
  data-ticker-symbols={JSON.stringify(tickerSymbols)}
>
  <div class="market-ticker-row market-ticker-row--unified">
    <div class="market-ticker-label" aria-hidden="true">MERCADOS</div>

    <div class="market-ticker-track">
      <div class="ticker-placeholder market-ticker-placeholder--unified">Carregando cotações…</div>
      <div class="market-ticker-viewport" aria-hidden="true">
        <div class="market-ticker-scale-frame">
          <div class="tradingview-widget-container" data-road-ticker="unified">
            <div class="tradingview-widget-container__widget"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="market-ticker-brand" aria-label="TradingView" title="TradingView">
      <svg aria-hidden="true" viewBox="0 0 35 19" width="35" height="19" fill="none">
        <g fill-rule="evenodd" clip-rule="evenodd">
          <path class="market-ticker-brand__stroke" d="M2 0H0v10h6v9h21.4l.5-1.3 6-15 1-2.7H23.7l-.5 1.3-.2.6a5 5 0 0 0-7-.9V0H2Zm20 17h4l5.2-13 .8-2h-7l-1 2.5-.2.5-1.5 3.8-.3.7V17Zm-.8-10a3 3 0 0 0 .7-2.7A3 3 0 1 0 16.8 7h4.4ZM14 7V2H2v6h6v9h4V7h2Z"/>
          <path class="market-ticker-brand__fill" d="M14 2H2v6h6v9h6V2Zm12 15h-7l6-15h7l-6 15Zm-7-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
        </g>
      </svg>
    </div>
  </div>
</div>

<script is:inline>
  (()=>{
    const root=document.getElementById('market-ticker-shell');
    if(!root || root.dataset.tickerController==='1') return;
    root.dataset.tickerController='1';

    const host=root.querySelector('[data-road-ticker="unified"]');
    const placeholder=root.querySelector('.market-ticker-placeholder--unified');
    if(!(host instanceof HTMLElement)) return;

    let symbols=[];
    try{
      symbols=JSON.parse(root.dataset.tickerSymbols || '[]');
    }catch{
      symbols=[];
    }

    let ready=false;
    const setReady=()=>{
      if(ready) return;
      ready=true;
      requestAnimationFrame(()=>requestAnimationFrame(()=>{
        root.classList.add('is-unified-ticker-ready');
      }));
    };

    const observer=new MutationObserver(()=>{
      const iframe=host.querySelector('iframe');
      if(!(iframe instanceof HTMLIFrameElement) || iframe.dataset.roadTickerArmed==='1') return;
      iframe.dataset.roadTickerArmed='1';
      iframe.addEventListener('load',()=>window.setTimeout(setReady,250),{once:true});
    });
    observer.observe(host,{childList:true,subtree:true});

    const config={
      symbols,
      colorTheme:'dark',
      locale:'br',
      largeChartUrl:'',
      isTransparent:true,
      showSymbolLogo:true,
      displayMode:'adaptive',
    };

    const embed=document.createElement('script');
    embed.type='text/javascript';
    embed.src='https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js';
    embed.async=true;
    embed.textContent=JSON.stringify(config);
    embed.addEventListener('error',()=>{
      if(placeholder) placeholder.textContent='Carregando cotações…';
    },{once:true});
    host.appendChild(embed);
  })();
</script>
