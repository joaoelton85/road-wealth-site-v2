---
import BaseLayout from "../layouts/BaseLayout.astro";
import RoadMandala from "../components/RoadMandala.astro";
import "../styles/patrimonio.css";
import { ROAD_ACTIONS, ROAD_REPORT_INTRO, ROAD_REPORT_NOTICE, ROAD_CTA_LINK, ROAD_TAGLINE } from "../checkup-report.js";
---
<BaseLayout title="Patrimônio | ROAD Wealth®" description="Investimentos, Legado, Estratégia e Decisões em uma visão patrimonial integrada." active="patrimonio">
  <section class="hero section section--sand page-hero" id="inicio">
    <div class="eyebrow">PATRIMÔNIO</div>
    <h1>Áreas de atuação. Uma visão integrada.</h1>
    <p class="lead">Investimentos são parte central do patrimônio, mas não caminham sozinhos. A ROAD organiza sua atuação em frentes que se conectam: Investimentos, Legado, Estratégia e Decisões.</p>
    <div class="actions"><a class="btn btn--primary" href="#areas">Conheça as áreas</a><a class="btn btn--ghost" href="#checkup-road">Fazer o Check-up ROAD</a></div>
  </section>

  <section class="section section--white" id="areas">
    <div class="section-intro"><div class="eyebrow">PATRIMÔNIO</div><h2>Como cuidamos do seu patrimônio</h2><p>Cada área tem um papel próprio. O valor está em fazer com que elas conversem entre si, evitando decisões isoladas e criando uma visão mais consistente do patrimônio.</p></div>
    <div class="wealth-grid wealth-grid--visual">
      <RoadMandala />
      <div class="area-panel">
        <div class="eyebrow">ÁREAS DE ATUAÇÃO</div>
        <h3>Uma visão que conecta capital, proteção, estrutura e decisões.</h3>
        <p>Investimentos, Legado, Estratégia e Decisões possuem escopos próprios e podem ser acessados separadamente, sem perder a leitura do patrimônio como um todo.</p>
        <div class="area-link-list">
          <a href="/investimentos/">Investimentos <span>→</span></a>
          <a href="#legado">Legado <span>→</span></a>
          <a href="#estrategia">Estratégia <span>→</span></a>
          <a href="#decisoes">Decisões <span>→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="section-intro"><div class="eyebrow">ÁREAS DE ATUAÇÃO</div><h2>O que cada área observa.</h2><p>A profundidade de cada trabalho depende da realidade de cada família. O objetivo desta estrutura é organizar temas que frequentemente aparecem separados.</p></div>
    <div class="service-detail-grid">
      <article class="service-detail" id="investimentos"><div class="eyebrow">INVESTIMENTOS</div><h3>Capital investido.</h3><p>Política de Investimentos, consolidação entre instituições, diversificação, risco, liquidez, exposição internacional, acompanhamento e rebalanceamento.</p></article>
      <article class="service-detail" id="legado"><div class="eyebrow">LEGADO</div><h3>Proteção e continuidade.</h3><p>Sucessão, liquidez sucessória, previdência, proteção familiar, saúde e instrumentos que ajudam a preservar a continuidade patrimonial.</p></article>
      <article class="service-detail" id="estrategia"><div class="eyebrow">ESTRATÉGIA</div><h3>Objetivos transformados em um plano.</h3><p>Planejamento financeiro, liquidez, formação de patrimônio, aposentadoria, crédito, exposição internacional e organização dos recursos ao longo do tempo.</p></article>
      <article class="service-detail" id="decisoes"><div class="eyebrow">DECISÕES</div><h3>Escolhas que podem mudar o percurso.</h3><p>Imóveis, financiamentos, uso de capital próprio, participação em negócios, endividamento, grandes aquisições e outras decisões relevantes analisadas dentro do patrimônio como um todo.</p></article>
    </div>
  </section>

  <section class="section checkup-section" id="checkup-road">
    <div class="checkup-shell">
      <div class="section-intro"><div class="eyebrow">CHECK-UP ROAD</div><h2>Depois de conhecer as áreas de atuação, faça uma leitura inicial do seu patrimônio.</h2><p>O Check-up ROAD percorre Investimentos, Legado, Estratégia e Decisões em uma sequência guiada. São 16 perguntas, sem solicitar valores de patrimônio, renda, nomes de instituições ou outros dados sensíveis.</p></div>
      <div class="checkup-invite">
        <div class="eyebrow">CHECK-UP ROAD</div><h4>Uma visão rápida das áreas de atuação da ROAD.</h4><p>O Check-up percorre <strong>Investimentos, Legado, Estratégia e Decisões</strong>. São quatro perguntas por área, organizadas em uma sequência única e simples.</p>
        <div class="checkup-meta"><span>4 áreas</span><span>16 perguntas</span><span>cerca de 3 minutos</span></div><button class="btn btn--primary" id="open-checkup" type="button">Iniciar Check-up ROAD</button>
      </div>
      <div class="checkup" hidden id="checkup">
        <div class="checkup-intro" id="checkup-intro">
          <div class="checkup-head"><div><div class="eyebrow">ANTES DE COMEÇAR</div><h3>Você passará pelas áreas de atuação da ROAD.</h3></div><button class="text-btn" id="close-checkup" type="button">Fechar</button></div>
          <div class="checkup-areas"><div class="checkup-area-card"><small>1 de 4</small><strong>Investimentos</strong></div><div class="checkup-area-card"><small>2 de 4</small><strong>Legado</strong></div><div class="checkup-area-card"><small>3 de 4</small><strong>Estratégia</strong></div><div class="checkup-area-card"><small>4 de 4</small><strong>Decisões</strong></div></div>
          <p>Você não precisará informar valores de patrimônio, renda, nomes de instituições financeiras ou outros dados sensíveis. Suas respostas servem apenas para compor uma visão indicativa das áreas avaliadas.</p><button class="btn btn--primary" id="start-checkup" type="button">Começar por Investimentos</button>
        </div>
        <div class="checkup-flow" hidden id="checkup-flow">
          <div class="checkup-head"><div><div class="eyebrow" id="checkup-area">INVESTIMENTOS</div><h4 id="checkup-step-title">1 de 4 — Investimentos</h4></div><button class="text-btn" id="close-checkup-flow" type="button">Fechar</button></div>
          <div class="checkup-progress"><div class="progress-label"><span id="progress-copy">Área 1 de 4</span><span>4 perguntas</span></div><div class="progress-track"><div class="progress-bar" id="progress-bar"></div></div></div>
          <div class="questions" id="questions"></div><div class="result" hidden id="result"></div><div class="checkup-nav"><button class="btn btn--outline-coffee" hidden id="prev-checkup" type="button">← Área anterior</button><button class="btn btn--primary" disabled id="next-checkup" type="button">Próxima área →</button></div>
        </div>
        <div class="checkup-final" hidden id="checkup-final">
          <div class="checkup-head"><div><div class="eyebrow">RESULTADO</div><h3>Seu Check-up ROAD</h3></div><button class="text-btn" id="close-checkup-final" type="button">Fechar</button></div>
          <p>{ROAD_REPORT_INTRO}</p>
          <div class="scoreboard">
            <div class="road-map-heading"><h4>Seu mapa patrimonial</h4><span>Situação atual</span></div>
            <div class="scoreboard-grid" id="scoreboard-grid" aria-label="Posição patrimonial indicativa das quatro áreas"></div>
            <div class="road-map-legend" aria-hidden="true"><span><i class="is-attention"></i>Merece atenção</span><span><i class="is-developing"></i>Em desenvolvimento</span><span><i class="is-good"></i>Bem estruturado</span></div>
          </div>
          <section class="road-report-priorities" id="road-report-priorities" hidden aria-labelledby="road-priorities-title">
            <h4 id="road-priorities-title">Onde concentrar sua atenção</h4>
            <div id="road-priority-items"></div>
          </section>
          <div class="road-report-cta">
            <h4>Aprofunde seu diagnóstico</h4>
            <p>{ROAD_REPORT_NOTICE}</p>
            <a href={ROAD_CTA_LINK} class="btn btn--primary" target="_blank" rel="noopener noreferrer">Conversar com a ROAD</a>
          </div>
          <div class="delivery-box">
            <h4>Quer guardar seu resultado?</h4>
            <p>Você pode receber o resumo do Check-up por e-mail.</p>
            <div class="actions">
              <button class="btn btn--primary" id="open-checkup-email" type="button" aria-expanded="false" aria-controls="road-checkup-email">Receber por e-mail</button>
              
            </div>
            <div class="road-checkup-email" id="road-checkup-email" hidden>
              <form id="road-checkup-email-form">
                <label for="road-result-email">Seu e-mail</label>
                <input id="road-result-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" placeholder="voce@exemplo.com" required />
                <label class="road-checkup-consent" for="road-result-consent">
                  <input id="road-result-consent" name="consent" type="checkbox" required />
                  <span>Autorizo a ROAD a enviar o resultado deste Check-up para o e-mail informado.</span>
                </label>
                <p class="checkup-note">O endereço será usado para o envio solicitado. Consulte nossa <a href="/privacidade/">Política de Privacidade</a>.</p>
                <div id="road-checkup-turnstile" aria-label="Verificação de segurança"></div>
                <button id="road-checkup-email-submit" class="btn btn--primary" type="submit">Enviar meu resultado</button>
                <p id="road-checkup-email-feedback" class="road-checkup-email-feedback" role="status" aria-live="polite"></p>
              </form>
            </div>
          </div>
          <footer class="road-checkup-signature">
            <img src="/assets/road-logo-cafe.svg" alt="ROAD Wealth" width="55" loading="lazy" />
            <p>{ROAD_TAGLINE}</p>
            <div><a href="https://roadwealth.com.br/" target="_blank" rel="noopener noreferrer">roadwealth.com.br</a><span>·</span><a href="https://www.instagram.com/road.wealth/" target="_blank" rel="noopener noreferrer">Instagram @road.wealth</a></div>
          </footer>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--coffee cta-final" id="contato">
    <div class="eyebrow eyebrow--light">CONTATO</div><h2>Uma conversa pode ser o primeiro passo.</h2><p class="lead on-dark">Escolha o canal que fizer mais sentido para você.</p><div class="actions"><a class="btn btn--sand" href="https://wa.me/5542984242852?text=Ol%C3%A1!%20Conheci%20a%20ROAD%20Wealth%20pelo%20site%20e%20gostaria%20de%20conversar%20com%20a%20equipe." target="_blank" rel="noopener noreferrer" aria-label="Conversar com a ROAD Wealth pelo WhatsApp">WhatsApp</a><a class="btn btn--outline-light" href="mailto:contato@roadwealth.com.br">E-mail</a></div>
    <div class="socials" style="margin-top:20px"><a aria-label="Instagram da ROAD Wealth — @road.wealth" class="social-link" href="https://www.instagram.com/road.wealth/" rel="noopener noreferrer" target="_blank"><svg aria-hidden="true" class="social-icon" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><rect height="18" rx="5" stroke="currentColor" stroke-width="1.8" width="18" x="3" y="3"></rect><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"></circle><circle cx="17.4" cy="6.7" fill="currentColor" r="1.1"></circle></svg><span>@road.wealth</span></a><button class="social-link js-placeholder" data-message="A URL oficial do LinkedIn será inserida antes da publicação." type="button">LinkedIn</button></div>
  </section>

  <script type="application/json" id="road-checkup-recommendations" set:html={JSON.stringify(ROAD_ACTIONS)}></script>
  <script is:inline>
    const areas={
      investments:{kicker:'INVESTIMENTOS',title:'Uma estratégia antes de uma carteira.',body:'A ROAD parte dos objetivos, do perfil e da Política de Investimentos para analisar, consolidar e acompanhar as decisões financeiras do cliente — inclusive quando o patrimônio está distribuído entre diferentes instituições.',points:['Política de Investimentos','Consolidação de instituições','Diversificação e risco','Acompanhamento e rebalanceamento'],questions:['Sua carteira segue uma Política de Investimentos claramente definida?','Você conhece a concentração do seu patrimônio por instituição, emissor, classe de ativo e moeda?','Você sabe qual foi o retorno líquido e real dos seus investimentos nos últimos períodos?','Seus investimentos mantidos em diferentes instituições são analisados como uma única carteira?']},
      legacy:{kicker:'LEGADO',title:'Patrimônio também é proteção e continuidade.',body:'Legado amplia o olhar para sucessão, liquidez, previdência, proteção familiar, saúde e continuidade patrimonial.',points:['Sucessão e continuidade','Liquidez sucessória','Proteção familiar e vida','Saúde e previdência'],questions:['Sua família tem uma estimativa dos tributos, custos e liquidez necessários em uma eventual sucessão patrimonial?','Existem instrumentos ou reservas especificamente pensados para garantir liquidez à família nesse momento?','A família possui instrumentos de proteção médica compatíveis com o padrão de atendimento desejado, inclusive em hospitais de referência no Brasil ou no exterior?','As estruturas de proteção e sucessão existentes foram revisadas recentemente e ainda refletem a realidade atual da família e do patrimônio?']},
      strategy:{kicker:'ESTRATÉGIA',title:'Objetivos precisam se transformar em um plano.',body:'Estratégia organiza o planejamento financeiro de longo prazo: liquidez, formação de patrimônio, aposentadoria, crédito, exposição internacional e a distribuição dos recursos ao longo do tempo.',points:['Planejamento financeiro','Liquidez e reservas','Objetivos de longo prazo','Crédito e exposição internacional'],questions:['Seus objetivos financeiros de médio e longo prazo estão organizados com prazos e prioridades definidos?','Você sabe quanto precisa manter disponível para liquidez e reservas sem comprometer seus objetivos de longo prazo?','A formação de patrimônio e a aposentadoria possuem uma estratégia financeira acompanhada ao longo do tempo?','Crédito, exposição internacional e decisões de liquidez são avaliados dentro de um planejamento financeiro integrado?']},
      decisions:{kicker:'DECISÕES',title:'Algumas escolhas podem mudar o percurso.',body:'Decisões reúne situações relevantes que merecem ser analisadas dentro do patrimônio como um todo — imóveis, financiamentos, negócios, endividamento, grandes aquisições e outras escolhas de impacto.',points:['Imóveis e aquisições','Capital próprio x financiamento','Negócios e participações','Decisões patrimoniais relevantes'],questions:['Antes de uma decisão patrimonial relevante, você costuma comparar seu impacto sobre liquidez, risco e objetivos de longo prazo?','Em aquisições importantes, você avalia diferentes formas de pagamento, financiamento ou uso de capital próprio?','Decisões envolvendo imóveis, empresas ou participações são analisadas junto do restante do patrimônio?','Quando uma escolha exige especialistas de diferentes áreas, existe coordenação entre essas análises?']}
    };
    const answers={};const checkupOrder=['investments','legacy','strategy','decisions'];let checkupStep=0;
    const qs=s=>document.querySelector(s),qsa=s=>[...document.querySelectorAll(s)];
    const checkup=qs('#checkup'),questions=qs('#questions'),result=qs('#result'),scoreGrid=qs('#scoreboard-grid'),checkupArea=qs('#checkup-area');
    const REPORT_POINTS={sim:3,parcial:2,nao:1,naosei:0};
    const REPORT_ACTIONS=JSON.parse(qs('#road-checkup-recommendations').textContent);
    const scoreFor=(key)=>areas[key].questions.reduce((sum,_,i)=>sum+(REPORT_POINTS[answers[key+'-'+i]]??0),0);
    const statusFor=(key)=>{if(!areas[key].questions.every((_,i)=>answers[key+'-'+i]))return 'Ainda não respondido';const n=scoreFor(key);return n>=10?'Bem estruturado':n>=7?'Em desenvolvimento':'Merece atenção'};
    function getReportPriorities(){
      const candidates=[];
      checkupOrder.forEach(key=>{
        const total=scoreFor(key);
        areas[key].questions.forEach((_,i)=>{
          const choice=answers[key+'-'+i];
          if(choice==='sim')return;
          const info=REPORT_ACTIONS[key][i];
          candidates.push({area:key,title:info.title,detail:choice==='naosei'?info.unknown:info.action,
            severity:choice==='naosei'?3:choice==='nao'?2:1,areaScore:total,index:i});
        });
      });
      candidates.sort((a,b)=>b.severity-a.severity||a.areaScore-b.areaScore||a.index-b.index);
      const chosen=[];
      for(const item of candidates){if(!chosen.some(x=>x.area===item.area))chosen.push(item);if(chosen.length===2)break}
      for(const item of candidates){if(chosen.length===2)break;if(!chosen.includes(item))chosen.push(item)}
      if(!chosen.length)return [
        {title:'Manter a revisão periódica',detail:'Revisar as diretrizes patrimoniais conforme mudarem os objetivos e a realidade familiar.'},
        {title:'Preservar a visão integrada',detail:'Continuar avaliando investimentos, proteção, estratégia e decisões em conjunto.'}
      ];
      if(chosen.length===1)chosen.push({title:'Revisão integrada',detail:'Manter a revisão periódica das quatro áreas para acompanhar novas necessidades.'});
      return chosen.slice(0,2);
    }
    function renderScore(){
      scoreGrid.innerHTML='';
      const allComplete=checkupOrder.every(k=>areas[k].questions.every((_,i)=>answers[k+'-'+i]));
      const priorities=qs('#road-report-priorities'),items=qs('#road-priority-items');
      if(!allComplete){priorities.hidden=true;return}
      checkupOrder.forEach(key=>{
        const total=scoreFor(key),value=(100*total/12).toFixed(2);
        const status=statusFor(key);
        const row=document.createElement('div');
        row.className='road-map-row';
        const line=document.createElement('div');line.className='road-map-line';
        const areaTitle=document.createElement('strong');areaTitle.textContent=areas[key].kicker;
        const resultLabel=document.createElement('span');resultLabel.textContent=status;
        resultLabel.className=total>=10?'is-good':total>=7?'is-developing':'is-attention';
        const bar=document.createElement('div');bar.className='road-map-bar';
        bar.setAttribute('role','img');bar.setAttribute('aria-label',areas[key].kicker+': '+status);
        const marker=document.createElement('span');marker.className='road-map-marker';marker.style.left=value+'%';
        line.append(areaTitle,resultLabel);bar.appendChild(marker);row.append(line,bar);
        scoreGrid.appendChild(row);
      });
      items.replaceChildren();
      getReportPriorities().forEach((suggestion,i)=>{
        const row=document.createElement('div');row.className='road-priority-row';
        const title=document.createElement('strong');title.textContent=String(i+1).padStart(2,'0')+' · '+suggestion.title;
        const detail=document.createElement('p');detail.textContent=suggestion.detail;
        row.append(title,detail);items.appendChild(row);
      });
      priorities.hidden=false;
    }
    function currentComplete(){const key=checkupOrder[checkupStep];return areas[key].questions.every((_,i)=>answers[key+'-'+i])}
    function renderCheckup(){const key=checkupOrder[checkupStep],a=areas[key];checkupArea.textContent=a.kicker;qs('#checkup-step-title').textContent=`${checkupStep+1} de 4 — ${a.kicker.charAt(0)+a.kicker.slice(1).toLowerCase()}`;qs('#progress-copy').textContent=`Área ${checkupStep+1} de 4`;qs('#progress-bar').style.width=`${(checkupStep+1)*25}%`;questions.innerHTML='';a.questions.forEach((q,i)=>{const answerKey=key+'-'+i;const row=document.createElement('div');row.className='question';row.innerHTML=`<p>${q}</p><div class="answers"><button type="button" data-key="${answerKey}" data-value="sim">Sim</button><button type="button" data-key="${answerKey}" data-value="parcial">Parcialmente</button><button type="button" data-key="${answerKey}" data-value="nao">Não</button><button type="button" data-key="${answerKey}" data-value="naosei">Não sei</button></div>`;questions.appendChild(row)});qsa('.answers button').forEach(b=>{if(answers[b.dataset.key]===b.dataset.value)b.classList.add('selected');b.addEventListener('click',()=>{answers[b.dataset.key]=b.dataset.value;qsa(`button[data-key="${b.dataset.key}"]`).forEach(x=>x.classList.toggle('selected',x===b));renderStepResult();updateCheckupNav()})});qs('#prev-checkup').hidden=checkupStep===0;qs('#next-checkup').textContent=checkupStep===3?'Ver resultado →':'Próxima área →';renderStepResult();updateCheckupNav()}
    function renderStepResult(){const key=checkupOrder[checkupStep];if(!currentComplete()){result.hidden=true;return}const st=statusFor(key);result.hidden=false;result.innerHTML=st==='Bem estruturado'?'<strong>Esta área parece relativamente bem estruturada.</strong><br>O resultado final considerará a integração com as demais áreas.':st==='Em desenvolvimento'?'<strong>Há elementos estruturados e pontos que ainda merecem revisão.</strong><br>O resultado final mostrará esta área em conjunto com as demais.':'<strong>Existem pontos relevantes que merecem atenção.</strong><br>O resultado final ajudará a visualizar onde podem estar as prioridades.'}
    function updateCheckupNav(){qs('#next-checkup').disabled=!currentComplete()}
    function openCheckup(){checkup.hidden=false;qs('#checkup-intro').hidden=false;qs('#checkup-flow').hidden=true;qs('#checkup-final').hidden=true;checkup.scrollIntoView({behavior:'smooth',block:'start'})}
    function closeCheckup(){checkup.hidden=true}
    qs('#open-checkup')?.addEventListener('click',openCheckup);qs('#close-checkup')?.addEventListener('click',closeCheckup);qs('#close-checkup-flow')?.addEventListener('click',closeCheckup);qs('#close-checkup-final')?.addEventListener('click',closeCheckup);
    qs('#start-checkup')?.addEventListener('click',()=>{checkupStep=0;qs('#checkup-intro').hidden=true;qs('#checkup-flow').hidden=false;renderCheckup();qs('#checkup-flow').scrollIntoView({behavior:'smooth',block:'start'})});
    qs('#prev-checkup')?.addEventListener('click',()=>{if(checkupStep>0){checkupStep--;renderCheckup();}});
    qs('#next-checkup')?.addEventListener('click',()=>{if(!currentComplete())return;if(checkupStep<3){checkupStep++;renderCheckup();qs('#checkup-flow').scrollIntoView({behavior:'smooth',block:'start'})}else{qs('#checkup-flow').hidden=true;qs('#checkup-final').hidden=false;renderScore();qs('#checkup-final').scrollIntoView({behavior:'smooth',block:'start'})}});

    // Envio opcional do resultado por e-mail. Nenhum dado é enviado antes da confirmação.
    const roadEmailOpen=qs('#open-checkup-email');
    const roadEmailPanel=qs('#road-checkup-email');
    const roadEmailForm=qs('#road-checkup-email-form');
    if(roadEmailOpen && roadEmailPanel && roadEmailForm){
      const feedback=qs('#road-checkup-email-feedback');
      const submitButton=qs('#road-checkup-email-submit');
      let verificationToken='';
      let verificationWidget=null;
      let setupPending=null;
      let emailSent=false;

      const showEmailFeedback=(message)=>{feedback.textContent=message;};
      const loadTurnstile=()=>new Promise((resolve,reject)=>{
        if(window.turnstile){resolve();return;}
        let script=document.querySelector('script[data-road-turnstile]');
        if(!script){
          script=document.createElement('script');
          script.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
          script.async=true;
          script.dataset.roadTurnstile='true';
          document.head.appendChild(script);
        }
        const timer=setTimeout(()=>reject(new Error('Tempo esgotado ao carregar a verificação.')),12000);
        script.addEventListener('load',()=>{clearTimeout(timer);resolve();},{once:true});
        script.addEventListener('error',()=>{clearTimeout(timer);script.remove();reject(new Error('Verificação indisponível.'))},{once:true});
      });
      const prepareEmailVerification=async()=>{
        const response=await fetch('/api/checkup-config',{cache:'no-store'});
        if(!response.ok)throw new Error('O serviço de envio está temporariamente indisponível.');
        const config=await response.json();
        if(!config.enabled || !config.siteKey)throw new Error('O envio por e-mail ainda não está disponível.');
        await loadTurnstile();
        if(!window.turnstile)throw new Error('Verificação de segurança indisponível.');
        if(verificationWidget===null){
          verificationWidget=window.turnstile.render('#road-checkup-turnstile',{
            sitekey:config.siteKey,
            action:'road_checkup_email',
            callback:(token)=>{verificationToken=token;showEmailFeedback('');},
            'expired-callback':()=>{verificationToken='';showEmailFeedback('A verificação expirou. Conclua novamente.');},
            'error-callback':()=>{verificationToken='';showEmailFeedback('Não foi possível verificar a segurança. Tente novamente.');}
          });
        }
      };

      roadEmailOpen.addEventListener('click',()=>{
        roadEmailPanel.hidden=!roadEmailPanel.hidden;
        roadEmailOpen.setAttribute('aria-expanded',String(!roadEmailPanel.hidden));
        if(roadEmailPanel.hidden || emailSent)return;
        qs('#road-result-email')?.focus();
        if(setupPending)return;
        showEmailFeedback('Preparando envio seguro...');
        setupPending=prepareEmailVerification()
          .then(()=>showEmailFeedback(''))
          .catch(error=>{showEmailFeedback(error.message||'Não foi possível preparar o envio.');setupPending=null;});
      });

      roadEmailForm.addEventListener('submit',async(event)=>{
        event.preventDefault();
        if(emailSent || submitButton.disabled)return;
        if(!roadEmailForm.reportValidity())return;
        if(!verificationToken){showEmailFeedback('Conclua a verificação de segurança para enviar.');return;}
        const email=qs('#road-result-email').value.trim();
        submitButton.disabled=true;
        showEmailFeedback('Enviando resultado...');
        const controller=new AbortController();
        const timeout=setTimeout(()=>controller.abort(),15000);
        try{
          const response=await fetch('/api/checkup-email',{
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({email,consent:qs('#road-result-consent').checked,answers,turnstileToken:verificationToken}),
            signal:controller.signal
          });
          let result={};
          try{result=await response.json();}catch{}
          if(!response.ok)throw new Error(result.error||'Não foi possível enviar. Tente novamente.');
          emailSent=true;
          showEmailFeedback('Solicitação de envio recebida. Confira sua caixa de entrada e o Spam.');
        }catch(error){
          showEmailFeedback(error.name==='AbortError'?'A solicitação demorou demais. Confirme o recebimento antes de tentar novamente.':(error.message||'Falha no envio.'));
          verificationToken='';
          if(verificationWidget!==null && window.turnstile)window.turnstile.reset(verificationWidget);
        }finally{
          clearTimeout(timeout);
          if(!emailSent)submitButton.disabled=false;
        }
      });
    }
    renderScore();
  </script>
</BaseLayout>
