---
import BaseLayout from "../layouts/BaseLayout.astro";
import RoadMandala from "../components/RoadMandala.astro";
import { ROAD_CHECKUP_PROFILES } from "../checkup-profiles.js";
import "../styles/patrimonio.css";

---
<BaseLayout title="Patrimônio | ROAD Wealth®" description="Investimentos, Legado, Capital e Planejamento em uma visão patrimonial integrada." active="patrimonio">
  <section class="hero section section--sand page-hero" id="inicio">
    <div class="eyebrow">PATRIMÔNIO</div>
    <h1>Áreas de atuação. Uma visão integrada.</h1>
    <p class="lead">Investimentos são parte central do patrimônio, mas não caminham sozinhos. A ROAD organiza sua atuação em frentes que se conectam: Investimentos, Legado, Capital e Planejamento.</p>
    <div class="actions"><a class="btn btn--primary" href="#areas">Conheça as áreas</a><a class="btn btn--ghost" href="#checkup-road">Fazer o Check-up Financeiro</a></div>
  </section>

  <section class="section section--white" id="areas">
    <div class="section-intro"><div class="eyebrow">PATRIMÔNIO</div><h2>Como cuidamos do seu patrimônio</h2><p>Cada área tem um papel próprio. O valor está em fazer com que elas conversem entre si, evitando decisões isoladas e criando uma visão mais consistente do patrimônio.</p></div>
    <div class="wealth-grid wealth-grid--visual">
      <RoadMandala />
      <div class="area-panel">
        <div class="eyebrow">ÁREAS DE ATUAÇÃO</div>
        <h3>Uma visão que conecta investimentos, proteção, recursos e planejamento.</h3>
        <p>Investimentos, Legado, Capital e Planejamento possuem escopos próprios e podem ser acessados separadamente, sem perder a leitura do patrimônio como um todo.</p>
        <div class="area-link-list">
          <a href="/investimentos/">Investimentos <span>→</span></a>
          <a href="#legado">Legado <span>→</span></a>
          <a href="#capital">Capital <span>→</span></a>
          <a href="#planejamento">Planejamento <span>→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="section-intro"><div class="eyebrow">ÁREAS DE ATUAÇÃO</div><h2>O que cada área observa.</h2><p>A profundidade de cada trabalho depende da realidade de cada família. O objetivo desta estrutura é organizar temas que frequentemente aparecem separados.</p></div>
    <div class="service-detail-grid">
      <article class="service-detail" id="investimentos"><div class="eyebrow">INVESTIMENTOS</div><h3>Capital investido.</h3><p>Política de Investimentos, consolidação entre instituições, diversificação, risco, liquidez, exposição internacional, acompanhamento e rebalanceamento.</p></article>
      <article class="service-detail" id="legado"><div class="eyebrow">LEGADO</div><h3>Proteção e continuidade.</h3><p>Sucessão, liquidez sucessória, previdência, proteção familiar, saúde, seguros de bens e instrumentos que ajudam a preservar a continuidade patrimonial.</p></article>
      <span id="estrategia" class="sr-only" aria-hidden="true"></span><article class="service-detail" id="capital"><div class="eyebrow">CAPITAL</div><h3>Inteligência na utilização dos recursos.</h3><p>Linhas de crédito, capital próprio e de terceiros, captação, gestão de caixa, tesouraria, garantias e estrutura financeira de famílias e empresas.</p></article>
      <span id="decisoes" class="sr-only" aria-hidden="true"></span><article class="service-detail" id="planejamento"><div class="eyebrow">PLANEJAMENTO</div><h3>Do cotidiano às grandes decisões patrimoniais.</h3><p>Objetivos familiares, organização financeira, aposentadoria, avaliação de projetos, decisões sobre imóveis e negócios e planejamento financeiro e patrimonial integrado.</p></article>
    </div>
  </section>

  <section class="section checkup-section" id="checkup-road">
    <div class="checkup-shell">
      <div class="checkup-entry">
        <div class="eyebrow">CHECK-UP ROAD</div>
        <h2>Conheça melhor a organização do seu patrimônio.</h2>
        <p>Responda a 16 perguntas sobre <strong>Investimentos, Legado, Capital e Planejamento</strong>, de acordo com sua realidade familiar ou empresarial. Sem informar valores ou dados sensíveis. Sua análise será enviada por e-mail.</p>
        <button class="btn btn--primary" id="open-checkup" type="button">Iniciar Check-up Financeiro</button>
      </div>
      <div class="checkup" hidden id="checkup">
        <div class="checkup-profile" id="checkup-profile" hidden>
          <div class="checkup-head"><div><div class="eyebrow">SEU PERFIL</div><h3>Qual perspectiva representa melhor sua realidade?</h3></div><button class="text-btn" id="close-checkup-profile" type="button">Fechar</button></div>
          <p>O conteúdo se adapta à sua realidade. Quem possui atividade rural pode escolher Empresarial / Agro, mesmo atuando como pessoa física.</p>
          <fieldset class="checkup-profile-options">
            <legend class="sr-only">Selecione o percurso do Check-up ROAD</legend>
            <label class="checkup-profile-option"><input type="radio" name="road-checkup-profile" value="familiar" /><span><strong>Patrimonial / Familiar</strong><small>Investimentos, proteção e planejamento do patrimônio pessoal e familiar.</small></span></label>
            <label class="checkup-profile-option"><input type="radio" name="road-checkup-profile" value="empresarial" /><span><strong>Empresarial / Agro</strong><small>Patrimônio familiar, negócios, crédito, gestão de caixa e atividade rural.</small></span></label>
          </fieldset>
          <button class="btn btn--primary" id="begin-profile-checkup" type="button" disabled>Continuar para as perguntas</button>
        </div>
        <div class="checkup-flow" hidden id="checkup-flow">
          <div class="checkup-head"><div><div class="eyebrow" id="checkup-area">INVESTIMENTOS</div><h4 id="checkup-step-title">1 de 4 — Investimentos</h4></div><button class="text-btn" id="close-checkup-flow" type="button">Fechar</button></div>
          <div class="checkup-progress"><div class="progress-label"><span id="progress-copy">Área 1 de 4</span><span id="checkup-question-count">4 perguntas</span></div><div class="progress-track"><div class="progress-bar" id="progress-bar"></div></div></div>
          <div class="questions" id="questions"></div><div class="checkup-nav"><button class="btn btn--outline-coffee" hidden id="prev-checkup" type="button">← Área anterior</button><button class="btn btn--primary" disabled id="next-checkup" type="button">Próxima área →</button></div>
        </div>

        <div class="checkup-final" hidden id="checkup-final">
          <div class="checkup-head"><div><div class="eyebrow">ÚLTIMA ETAPA</div><h3>Seu Check-up está concluído.</h3></div><button class="text-btn" id="close-checkup-final" type="button">Fechar</button></div>
          <p>Obrigado por concluir as 16 perguntas. Informe seu e-mail para receber o resumo das quatro áreas e o diagnóstico completo em PDF anexo.</p><p id="checkup-finished-profile" class="checkup-finished-profile"></p>
          <div class="delivery-box road-checkup-delivery">
            <h4>Receba sua análise por e-mail</h4>
            <p>Seu diagnóstico será enviado exclusivamente para o endereço informado. Ele não será exibido nesta página.</p>
            <div class="road-checkup-email" id="road-checkup-email">
              <form id="road-checkup-email-form">
                <label for="road-result-email">Seu e-mail</label>
                <input id="road-result-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" placeholder="voce@exemplo.com" required />
                <label class="road-checkup-consent" for="road-result-consent">
                  <input id="road-result-consent" name="consent" type="checkbox" required />
                  <span>Autorizo a ROAD a enviar o resultado deste Check-up para o e-mail informado.</span>
                </label>
                <p class="checkup-note">O endereço será utilizado para este envio. Consulte nossa <a href="/privacidade/">Política de Privacidade</a>.</p>
                <div id="road-checkup-turnstile" aria-label="Verificação de segurança"></div>
                <button id="road-checkup-email-submit" class="btn btn--primary" type="submit">Receber minha análise</button>
                <p id="road-checkup-email-feedback" class="road-checkup-email-feedback" role="status" aria-live="polite"></p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--coffee cta-final" id="contato">
    <div class="eyebrow eyebrow--light">CONTATO</div>
    <h2>Uma conversa pode ser o primeiro passo.</h2>
    <p class="lead on-dark">Escolha o canal que fizer mais sentido para você.</p>
    <div class="road-contact-channels" aria-label="Canais da ROAD Wealth">
      <a class="btn btn--sand" href="https://wa.me/5542984242852?text=Ol%C3%A1!%20Conheci%20a%20ROAD%20Wealth%20pelo%20site%20e%20gostaria%20de%20conversar%20com%20a%20equipe." target="_blank" rel="noopener noreferrer" aria-label="Conversar com a ROAD Wealth pelo WhatsApp">WhatsApp</a>
      <a class="btn btn--outline-light" href="mailto:contato@roadwealth.com.br">E-mail</a>
      <a aria-label="Instagram da ROAD Wealth — @road.wealth" class="social-link" href="https://www.instagram.com/road.wealth/" rel="noopener noreferrer" target="_blank"><svg aria-hidden="true" class="social-icon" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><rect height="18" rx="5" stroke="currentColor" stroke-width="1.8" width="18" x="3" y="3"></rect><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"></circle><circle cx="17.4" cy="6.7" fill="currentColor" r="1.1"></circle></svg><span>@road.wealth</span></a>
      <button class="social-link js-placeholder" data-message="A URL oficial do LinkedIn será inserida antes da publicação." type="button">LinkedIn</button>
    </div>
  </section>

  <script id="road-checkup-profiles-data" type="application/json" set:html={JSON.stringify(ROAD_CHECKUP_PROFILES)} />
  <script is:inline>
    const profiles=JSON.parse(document.getElementById('road-checkup-profiles-data').textContent);
    let profile=null;
    let areas=profiles.familiar.areas;
    const answers={};const checkupOrder=['investments','legacy','capital','planning'];let checkupStep=0;
    const qs=s=>document.querySelector(s),qsa=s=>[...document.querySelectorAll(s)];
    const checkup=qs('#checkup'),questions=qs('#questions'),checkupArea=qs('#checkup-area');
    // Âncora do Check-up: com navegação Astro, carregamento de fontes e cabeçalho
    // sticky, a rolagem nativa pode deixar o convite fora da primeira tela.
    // Alinha apenas a abertura direta por hash, sem interferir no questionário.
    if(location.hash==='#checkup-road'){
      const alignCheckupAnchor=()=>{
        const target=qs('#checkup-road');
        if(!target)return;
        const stack=qs('#site-top-stack');
        const topGap=(stack?.getBoundingClientRect().height||0)+6;
        const delta=target.getBoundingClientRect().top-topGap;
        if(Math.abs(delta)>5){
          window.scrollTo({top:Math.max(0,window.scrollY+delta),behavior:'instant'});
        }
      };
      requestAnimationFrame(()=>requestAnimationFrame(alignCheckupAnchor));
      document.fonts?.ready?.then(alignCheckupAnchor);
      document.addEventListener('astro:page-load',()=>requestAnimationFrame(alignCheckupAnchor),{once:true});
    }

    function currentComplete(){const key=checkupOrder[checkupStep];return areas[key].questions.every((_,i)=>answers[key+'-'+i])}
    function renderCheckup(){
      const key=checkupOrder[checkupStep],a=areas[key];
      checkupArea.textContent=a.kicker;
      qs('#checkup-step-title').textContent=`${checkupStep+1} de 4 — ${a.kicker.charAt(0)+a.kicker.slice(1).toLowerCase()}`;
      qs('#progress-copy').textContent=`Área ${checkupStep+1} de 4`;
      qs('#checkup-question-count').textContent=`${a.questions.length} perguntas`;
      qs('#progress-bar').style.width=`${(checkupStep+1)*25}%`;
      questions.innerHTML='';
      a.questions.forEach((q,i)=>{
        const answerKey=key+'-'+i, row=document.createElement('div');
        row.className='question';
        const prompt=document.createElement('p');
        prompt.textContent=q;
        const buttons=document.createElement('div');
        buttons.className='answers';
        for(const [value,label] of [['sim','Sim'],['parcial','Parcialmente'],['nao','Não'],['naosei','Não sei']]){
          const button=document.createElement('button');
          button.type='button';button.dataset.key=answerKey;button.dataset.value=value;button.textContent=label;
          button.classList.toggle('selected',answers[answerKey]===value);
          button.addEventListener('click',()=>{
            answers[answerKey]=value;
            buttons.querySelectorAll('button').forEach(x=>x.classList.toggle('selected',x===button));
            updateCheckupNav();
          });
          buttons.appendChild(button);
        }
        row.append(prompt,buttons);questions.appendChild(row);
      });
      qs('#prev-checkup').hidden=checkupStep===0;
      qs('#next-checkup').textContent=checkupStep===3?'Concluir e receber por e-mail →':'Próxima área →';
      updateCheckupNav();
    }
    function updateCheckupNav(){qs('#next-checkup').disabled=!currentComplete()}
    function openCheckup(){
      Object.keys(answers).forEach(key=>delete answers[key]);
      profile=null;checkupStep=0;
      qsa('input[name="road-checkup-profile"]').forEach(input=>input.checked=false);
      qs('#begin-profile-checkup').disabled=true;
      checkup.hidden=false;
      qs('#checkup-profile').hidden=false;
      qs('#checkup-flow').hidden=true;
      qs('#checkup-final').hidden=true;
      qs('#checkup-profile').scrollIntoView({behavior:'smooth',block:'start'});
    }
    function closeCheckup(){checkup.hidden=true}
    qsa('input[name="road-checkup-profile"]').forEach(input=>input.addEventListener('change',()=>{
      qs('#begin-profile-checkup').disabled=!qs('input[name="road-checkup-profile"]:checked');
    }));
    qs('#begin-profile-checkup').addEventListener('click',()=>{
      const selected=qs('input[name="road-checkup-profile"]:checked')?.value;
      if(!selected || !profiles[selected])return;
      profile=selected;areas=profiles[selected].areas;checkupStep=0;
      Object.keys(answers).forEach(key=>delete answers[key]);
      qs('#checkup-profile').hidden=true;
      qs('#checkup-flow').hidden=false;
      renderCheckup();
      qs('#checkup-flow').scrollIntoView({behavior:'smooth',block:'start'});
    });
    qs('#open-checkup')?.addEventListener('click',openCheckup);
    qs('#close-checkup-profile')?.addEventListener('click',closeCheckup);
    qs('#close-checkup-flow')?.addEventListener('click',closeCheckup);
    qs('#close-checkup-final')?.addEventListener('click',closeCheckup);
    qs('#prev-checkup')?.addEventListener('click',()=>{if(checkupStep>0){checkupStep--;renderCheckup();}});
    qs('#next-checkup')?.addEventListener('click',()=>{
      if(!currentComplete())return;
      if(checkupStep<3){checkupStep++;renderCheckup();qs('#checkup-flow').scrollIntoView({behavior:'smooth',block:'start'});}
      else{
        qs('#checkup-flow').hidden=true;
        qs('#checkup-final').hidden=false;
        qs('#checkup-finished-profile').textContent='Percurso: '+profiles[profile].label;
        qs('#checkup-final').dispatchEvent(new Event('road:checkup-finished'));
        qs('#checkup-final').scrollIntoView({behavior:'smooth',block:'start'});
      }
    });

    // Envio opcional do resultado por e-mail. Nenhum dado é enviado antes da confirmação.
    const roadEmailPanel=qs('#road-checkup-email');
    const roadEmailForm=qs('#road-checkup-email-form');
    if(roadEmailPanel && roadEmailForm){
      const feedback=qs('#road-checkup-email-feedback');
      const submitButton=qs('#road-checkup-email-submit');
      let verificationToken='';
      let verificationWidget=null;
      let setupPending=null;
      let emailSent=false;

      const showEmailFeedback=(message)=>{feedback.textContent=message;};
      const loadTurnstile=()=>new Promise((resolve,reject)=>{
        if(window.turnstile){resolve();return;}
        let script=document.querySelector('script[data-road-turnstile]');
        if(!script){
          script=document.createElement('script');
          script.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
          script.async=true;
          script.dataset.roadTurnstile='true';
          document.head.appendChild(script);
        }
        const timer=setTimeout(()=>reject(new Error('Tempo esgotado ao carregar a verificação.')),12000);
        script.addEventListener('load',()=>{clearTimeout(timer);resolve();},{once:true});
        script.addEventListener('error',()=>{clearTimeout(timer);script.remove();reject(new Error('Verificação indisponível.'))},{once:true});
      });
      const prepareEmailVerification=async()=>{
        const response=await fetch('/api/checkup-config',{cache:'no-store'});
        if(!response.ok)throw new Error('O serviço de envio está temporariamente indisponível.');
        const config=await response.json();
        if(!config.enabled || !config.siteKey)throw new Error('O envio por e-mail ainda não está disponível.');
        await loadTurnstile();
        if(!window.turnstile)throw new Error('Verificação de segurança indisponível.');
        if(verificationWidget===null){
          verificationWidget=window.turnstile.render('#road-checkup-turnstile',{
            sitekey:config.siteKey,
            action:'road_checkup_email',
            callback:(token)=>{verificationToken=token;showEmailFeedback('');},
            'expired-callback':()=>{verificationToken='';showEmailFeedback('A verificação expirou. Conclua novamente.');},
            'error-callback':()=>{verificationToken='';showEmailFeedback('Não foi possível verificar a segurança. Tente novamente.');}
          });
        }
      };

      qs('#checkup-final').addEventListener('road:checkup-finished',()=>{
        if(emailSent)return;
        qs('#road-result-email')?.focus({preventScroll:true});
        if(setupPending)return;
        showEmailFeedback('Preparando envio seguro...');
        setupPending=prepareEmailVerification()
          .then(()=>showEmailFeedback(''))
          .catch(error=>{showEmailFeedback(error.message||'Não foi possível preparar o envio.');setupPending=null;});
      });
      qs('#open-checkup').addEventListener('click',()=>{
        emailSent=false;
        submitButton.disabled=false;
        roadEmailForm.reset();
        showEmailFeedback('');
        verificationToken='';
        if(verificationWidget!==null && window.turnstile)window.turnstile.reset(verificationWidget);
      });

      roadEmailForm.addEventListener('submit',async(event)=>{
        event.preventDefault();
        if(emailSent || submitButton.disabled)return;
        if(!roadEmailForm.reportValidity())return;
        if(!verificationToken){showEmailFeedback('Conclua a verificação de segurança para enviar.');return;}
        const email=qs('#road-result-email').value.trim();
        submitButton.disabled=true;
        showEmailFeedback('Enviando resultado...');
        const controller=new AbortController();
        const timeout=setTimeout(()=>controller.abort(),15000);
        try{
          const response=await fetch('/api/checkup-email',{
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({email,consent:qs('#road-result-consent').checked,profile,answers,turnstileToken:verificationToken}),
            signal:controller.signal
          });
          let result={};
          try{result=await response.json();}catch{}
          if(!response.ok)throw new Error(result.error||'Não foi possível enviar. Tente novamente.');
          emailSent=true;
          showEmailFeedback('Solicitação de envio recebida. Confira sua caixa de entrada e o Spam.');
        }catch(error){
          showEmailFeedback(error.name==='AbortError'?'A solicitação demorou demais. Confirme o recebimento antes de tentar novamente.':(error.message||'Falha no envio.'));
          verificationToken='';
          if(verificationWidget!==null && window.turnstile)window.turnstile.reset(verificationWidget);
        }finally{
          clearTimeout(timeout);
          if(!emailSent)submitButton.disabled=false;
        }
      });
    }
  </script>
</BaseLayout>
