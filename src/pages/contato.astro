---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contato | ROAD Wealth®" description="Entre em contato com a ROAD Wealth." active="contato">
  <section class="section section--sand page-hero contact-page contact-page--light">
    <div class="eyebrow">CONTATO</div>
    <h1>Uma conversa pode ser o primeiro passo.</h1>
    <p class="lead">Escolha o canal que fizer mais sentido para você.</p>

    <div class="contact-page-grid">
      <div>
        <div class="actions">
          <a class="btn btn--primary" href="https://wa.me/5542984242852?text=Ol%C3%A1!%20Conheci%20a%20ROAD%20Wealth%20pelo%20site%20e%20gostaria%20de%20conversar%20com%20a%20equipe." target="_blank" rel="noopener noreferrer" aria-label="Conversar com a ROAD Wealth pelo WhatsApp">WhatsApp</a>
          <a class="btn btn--outline-coffee" href="mailto:contato@roadwealth.com.br">E-mail</a>
        </div>
        <div class="socials contact-socials">
          <a aria-label="Instagram da ROAD Wealth — @road.wealth" class="social-link" href="https://www.instagram.com/road.wealth/" rel="noopener noreferrer" target="_blank">
            <svg aria-hidden="true" class="social-icon" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><rect height="18" rx="5" stroke="currentColor" stroke-width="1.8" width="18" x="3" y="3"></rect><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"></circle><circle cx="17.4" cy="6.7" fill="currentColor" r="1.1"></circle></svg>
            <span>@road.wealth</span>
          </a>
        </div>
      </div>
      <div class="contact-address">
        <strong>ROAD Wealth®</strong>
        <p>Rua Pater Josef Stefan, 1249<br/>Colônia Vitória · Entre Rios · Guarapuava/PR</p>
        <a href="mailto:contato@roadwealth.com.br">contato@roadwealth.com.br</a>
      </div>
    </div>
  </section>
</BaseLayout>
