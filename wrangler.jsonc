{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "road-wealth-site",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./src/worker.js",
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "contato@roadwealth.com.br"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "CHECKUP_EMAIL_RATE_LIMIT",
      "namespace_id": "592026",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF3d2CGykyL2vS6i",
    "LEAD_NOTIFICATIONS": "enabled"
  }
}
